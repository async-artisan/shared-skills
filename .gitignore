# 系统与编辑器
.DS_Store
*.swp

# Python
__pycache__/
*.pyc
.venv/

# 本地备份（apply/adopt 产生的回滚副本，不入库）
*.bak-*

# 本机状态（忽略名单、最近 apply；机器相关，不跨机器同步）
registry/state.yaml

# 个人技能台账（私有数据，不随公开仓分发；首次运行从 catalog.example.yaml 自动初始化）
registry/catalog.yaml
registry/catalog.yaml.pre-pull-*

# 机器本地留痕/缓存
registry/audit.logl
registry/undo/
registry/translate-cache.json

# 运行态临时输出
.claude-plugin-local/
.playwright-cli/
output/

# skills/ 是个人技能库，全部不入库（本仓库只开源 skillsync 工具与骨架）
skills/*
!skills/.gitkeep
