# 系统与编辑器
.DS_Store
*.swp

# Python
__pycache__/
*.pyc
.venv/

# 本地备份（apply/adopt 产生的回滚副本，不入库）
*.bak-*

# 本机状态（忽略名单、最近 apply；机器相关，不跨机器同步）
registry/state.yaml

# 多机 git 共享流：以下均为机器本地留痕/缓存，只同步事实源 skills/ 与 catalog.yaml
registry/audit.logl
registry/undo/
registry/translate-cache.json

# 运行态临时输出
.claude-plugin-local/
.playwright-cli/
output/

# 本机安装/采纳的个人 skills 不入库——只保留项目官方 skills
# 新增官方 skill 时用 git add -f skills/<slug>/ 强制跟踪
skills/*
!skills/.gitkeep
!skills/skill-finder-cn/
