{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "additionalContextLimit": 1000,
            "command": "\"<PYTHON_EXE>\" -X utf8 \"<SKILL_DIRECTORY>/scripts/compaction_reminder.py\" --state-dir \"<CODEX_HOME>/state/project-handoff\"",
            "timeout": 5
          }
        ],
        "matcher": "^(startup|resume|clear|compact)$"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "additionalContextLimit": 1000,
            "command": "\"<PYTHON_EXE>\" -X utf8 \"<SKILL_DIRECTORY>/scripts/compaction_reminder.py\" --state-dir \"<CODEX_HOME>/state/project-handoff\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON_EXE>\" -X utf8 \"<SKILL_DIRECTORY>/scripts/compaction_reminder.py\" --state-dir \"<CODEX_HOME>/state/project-handoff\"",
            "timeout": 5
          }
        ],
        "matcher": "^auto$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"<PYTHON_EXE>\" -X utf8 \"<SKILL_DIRECTORY>/scripts/compaction_reminder.py\" --state-dir \"<CODEX_HOME>/state/project-handoff\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "description": "project-handoff: 压缩节点评估补漏；仅最终文本核验计数；每轮最多一次补漏"
}
